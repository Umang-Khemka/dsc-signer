# --- Google Drive ---
# Folder ID of the shared "BLR" folder (the long ID at the end of its URL)
SOURCE_FOLDER_ID=
# Folder created in YOUR My Drive to hold the signed copies (created automatically)
DEST_ROOT_NAME=Signed Reports
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json

# --- Local folders (use D:, C: is nearly full) ---
WORK_DIR=D:\dsc-work
SIGNED_DIR=D:\signed

# --- Queue ---
REDIS_URL=redis://127.0.0.1:6379

# --- Signer (Python) ---
PYTHON=python
PKCS11_LIB=C:\Windows\System32\HYP2003csp11IND.dll
# Exported certificate (.cer, Base-64) of the signer, e.g. D:\tools\dsc-signer\cert.cer
CERT_FILE=
# Private key ID: run  python signer/sign_worker.py --list  and copy the id of the PRIVATE_KEY line
KEY_ID=
# Only if you can't use CERT_FILE / KEY_ID (labels with odd characters may not match):
CERT_LABEL=
KEY_LABEL=
# Optional: ';'-separated PEM files of the CA chain to embed
CA_CHAIN_FILES=
# Optional: trusted timestamp server URL
TSA_URL=